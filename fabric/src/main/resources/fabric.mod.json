{
  "schemaVersion": 1,
  "id": "left_forgotten",
  "version": "${mod_version}",
  "name": "Left Forgotten",
  "description": "Once glory days of Minecraft, now buried beneath the void. Minecraft Alpha is still there, but left and abandoned ages ago.",
  "authors": [
    "JustMili"
  ],
  "contributors": [
    "BluSpring",
    "NBSurprise"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/left-forgotten",
    "sources": "https://github.com/JustMili0/LeftForgotten/",
    "issues": "https://github.com/JustMili0/LeftForgotten/issues"
  },
  "license": "All Rights Reserved",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.justmili.leftforgotten.fabric.LeftForgottenFabric"
    ],
    "client": [
      "net.justmili.leftforgotten.fabric.client.FabricClient"
    ],
    "fabric-datagen": [
      "net.justmili.leftforgotten.core.datagen.fabric.FabricDatagen"
    ],
    "mixinsquared": [
      "net.justmili.leftforgotten.mixinsquared.fabric.CancelPerlinNoiseOverwrite"
    ]
  },
  "mixins": [
    "left_forgotten_common.mixins.json",
    "left_forgotten_fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "*"
  },
  "breaks": {
    "true_end": "*"
  }
}
